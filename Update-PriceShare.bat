@echo off
rem Updates PriceShare to the newest version from https://github.com/Ivan-Prcic/PriceShare
rem Keep this file inside Interface\AddOns\PriceShare and double-click it. Then /reload in game.
rem (Everything runs on one line on purpose: the update replaces this file while it runs.)
set "PS_DIR=%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; try { $dir=$env:PS_DIR.TrimEnd('\'); if ((Split-Path $dir -Leaf) -ne 'PriceShare' -or -not (Test-Path (Join-Path $dir 'PriceShare.toc'))) { throw 'Put this file in your Interface\AddOns\PriceShare folder and run it from there.' }; $toc=Join-Path $dir 'PriceShare.toc'; $oldFiles=(Get-Content $toc | Where-Object { $_ -notmatch '^\s*(##|$)' }) -join ','; $oldVer=((Select-String -Path $toc -Pattern '^## Version:\s*(.+)$').Matches | ForEach-Object { $_.Groups[1].Value }); $zip=Join-Path $env:TEMP 'PriceShare-main.zip'; $tmp=Join-Path $env:TEMP 'PriceShare-update'; Write-Host 'Downloading the newest PriceShare...'; [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; Invoke-WebRequest 'https://github.com/Ivan-Prcic/PriceShare/archive/refs/heads/main.zip' -OutFile $zip -UseBasicParsing; if (Test-Path $tmp) { Remove-Item $tmp -Recurse -Force }; Expand-Archive $zip $tmp -Force; $src=Join-Path $tmp 'PriceShare-main'; if (-not (Test-Path (Join-Path $src 'PriceShare.toc'))) { throw 'The download does not look like PriceShare, nothing was changed.' }; Copy-Item (Join-Path $src '*') $dir -Recurse -Force; Remove-Item $tmp -Recurse -Force; Remove-Item $zip -Force; $newFiles=(Get-Content $toc | Where-Object { $_ -notmatch '^\s*(##|$)' }) -join ','; $newVer=((Select-String -Path $toc -Pattern '^## Version:\s*(.+)$').Matches | ForEach-Object { $_.Groups[1].Value }); if ($newVer -eq $oldVer) { Write-Host ('You already have the newest PriceShare (' + $newVer + ').') } else { Write-Host ('PriceShare updated from ' + $oldVer + ' to ' + $newVer + '.') }; if ($newFiles -ne $oldFiles) { Write-Host 'This update adds files: restart WoW (a /reload is not enough).' -ForegroundColor Yellow } else { Write-Host 'If the game is running, type /reload.' } } catch { Write-Host ('Update failed: ' + $_.Exception.Message) -ForegroundColor Red }" & pause & exit /b
